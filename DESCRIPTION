Package: alloscore2
Title: Allocation Scoring Rules for Hubverse Model Output
Version: 0.0.0.9000
Authors@R: c(
    person(given = "Aaron",
           family = "Gerding",
           email = "agerding@umass.edu",
           role = c("aut", "cph"),
           comment = "Author of the original alloscore package"),
    person(given = "Nicholas",
